main.asm:
     1                          include "marvin.inc"
marvin.inc:
     1                          IFNDEF _MARVIN_INC
     2                          DEFINE _MARVIN_INC
     3                          
     4                          ; Marvin trampoline functions (ABI) - fixed ROM addresses
     5                          ; Each entry is a 3-byte JP instruction
     6                          ; Consumers call these addresses for Marvin I/O services
     7                          ;
     8                          ; Sections with limited availability note the supported targets in parentheses.
     9                          ; Unsupported targets have a stub entry that returns immediately.
    10                          ;
    11                          ; Implemented in entry_<target>.asm / entry_<target>_minimal.asm
    12                          
    13                          ; ENTRY POINTS - JP to these - they will not RETurn
    14                          
    15                          MARVIN_WARMSTART            EQU 0x0040  ; return to monitor prompt
    16                          
    17                          ; FUNCTIONS - CALL  these - they will RETurn
    18                          
    19                          ; Console I/O (routes to active console: USB, LCD+kbd, or RA8875+kbd)
    20                          MARVIN_PUTCHAR              EQU 0x0043  ; in: A=char           write char
    21                          MARVIN_PUTCHAR_HEX          EQU 0x0046  ; in: A=byte           write A as two hex digits
    22                          MARVIN_PUTS                 EQU 0x0049  ; in: HL=str(0-term)   write string
    23                          MARVIN_GETCHAR              EQU 0x004C  ; out: A=char          blocking read
    24                          MARVIN_READCHAR             EQU 0x004F  ; out: A=char (0=none) non-blocking read
    25                          
    26                          ; USB I/O  (all targets)
    27                          MARVIN_USB_PUTCHAR          EQU 0x0052  ; in: A=char           write char to USB
    28                          MARVIN_USB_PUTS             EQU 0x0055  ; in: HL=str(0-term)   write string to USB
    29                          MARVIN_USB_READCHAR         EQU 0x0058  ; out: A=char (0=none) non-blocking USB read
    30                          
    31                          ; LCD  (beanboard)
    32                          MARVIN_LCD_INIT             EQU 0x005B  ;                      initialise LCD
    33                          MARVIN_LCD_PUTCHAR          EQU 0x005E  ; in: A=char           write char to LCD
    34                          MARVIN_LCD_PUTS             EQU 0x0061  ; in: HL=str(0-term)   write string to LCD
    35                          
    36                          ; Keyboard  (beanboard, beandeck)
    37                          MARVIN_KEY_READCHAR         EQU 0x0064  ; out: A=char (0=none) non-blocking keyboard read
    38                          MARVIN_KEY_MODIFIERS        EQU 0x0067  ; out: A=modifier bits read modifier key state
    39                          
    40                          ; RA8875 TFT display  (beandeck)
    41                          MARVIN_RA8875_INIT          EQU 0x006A  ; out: Z=ok NZ=fail    initialise RA8875
    42                          MARVIN_RA8875_PUTCHAR       EQU 0x006D  ; in: A=char           write char to RA8875
    43                          MARVIN_RA8875_PUTS          EQU 0x0070  ; in: HL=str(0-term)   write string to RA8875
    44                          MARVIN_RA8875_CONSOLE_INIT             EQU 0x0073 ;            initialise console state
    45                          MARVIN_RA8875_CONSOLE_PUTCHAR          EQU 0x0076 ; in: A=char  console write (handles LF, scroll)
    46                          MARVIN_RA8875_CONSOLE_CURSOR_X         EQU 0x0079 ; in: A=col  set cursor column (0..RA8875_COLS-1)
    47                          MARVIN_RA8875_CONSOLE_CURSOR_Y         EQU 0x007C ; in: A=row  set cursor row (0..RA8875_ROWS-1, logical)
    48                          MARVIN_RA8875_CONSOLE_SET_CURSOR_COLOUR EQU 0x007F ; in: A=colour  set cursor colour (RA8875_COL_*)
    49                          MARVIN_RA8875_CONSOLE_SET_BG_COLOUR    EQU 0x0082 ; in: A=colour  set console background colour
    50                          MARVIN_RA8875_CONSOLE_CURSOR_HIDE      EQU 0x0085 ; hide software cursor
    51                          MARVIN_RA8875_CONSOLE_CURSOR_SHOW      EQU 0x0088 ; show software cursor
    52                          
    53                          ; Flash cartridge  (beandeck)
    54                          MARVIN_FLASH_READ         EQU 0x008B  ; in: A=addr[23:16] HL=addr[15:0] DE=dest BC=len  read from flash
    55                          MARVIN_FLASH_PAGE_PROGRAM EQU 0x008E  ; in: A=addr[23:16] HL=addr[15:0] DE=src BC=len   Z=ok NZ=timeout  write page
    56                          MARVIN_FLASH_SECTOR_ERASE EQU 0x0091  ; in: HL=sector number   Z=ok NZ=timeout  erase 4KB sector
    57                          MARVIN_FLASH_SELECT_SLOT  EQU 0x0094  ; in: A=slot (1-6)  caches JEDEC ID to W25Q_ID_MFR/TYPE/CAP
    58                          MARVIN_FLASH_READ_JEDEC_ID EQU 0x0097 ; out: A=mfr B=type C=cap           read JEDEC ID from current slot
    59                          MARVIN_FLASH_HAS_DEVICE       EQU 0x009A  ; out: Z=device present NZ=no device
    60                          MARVIN_FLASH_GET_DEVICE_ID    EQU 0x009D  ; out: A=mfr B=type C=cap         get cached JEDEC ID
    61                          MARVIN_FLASH_GET_DEVICE_NAME  EQU 0x00A0  ; out: HL=ptr to name string
    62                          MARVIN_FLASH_GET_CAPACITY_MB  EQU 0x00A3  ; out: A=capacity in MB
    63                          MARVIN_FLASH_GET_SECTOR_COUNT EQU 0x00A6  ; out: HL=total 4KB sector count
    64                          MARVIN_FLASH_BYTES_TO_SECTORS EQU 0x00A9  ; in: HL=byte count  out: A=sector count (ceiling)
    65                          MARVIN_FLASH_SECTOR_TO_ADDR   EQU 0x00AC  ; in: HL=sector number  out: A=addr[23:16] HL=addr[15:0]
    66                          
    67                          ; BDFS file system  (beandeck)
    68                          MARVIN_BDFS_INIT              EQU 0x00AF  ; initialise BDFS RAM state
    69                          MARVIN_BDFS_SET_DRIVE         EQU 0x00B2  ; in: A=drive letter ('A'-'F')
    70                          MARVIN_BDFS_GET_DRIVE         EQU 0x00B5  ; out: Z=ok A=drive letter; NZ A=BDFS_ERR_NO_DRIVE
    71                          MARVIN_BDFS_SELECT_DRIVE      EQU 0x00B8  ; in: A=drive letter  out: Z=ok NZ=BDFS_ERR_NO_DEVICE
    72                          MARVIN_BDFS_FORMAT            EQU 0x00BB  ; in: HL=vol name (0=default)  out: Z=ok NZ=BDFS_ERR_*
    73                          MARVIN_BDFS_DIR_OPEN          EQU 0x00BE  ; out: Z=ok HL=vol name ptr; NZ=BDFS_ERR_NOT_FORMATTED
    74                          MARVIN_BDFS_DIR_NEXT          EQU 0x00C1  ; out: Z=ok HL=entry ptr; NZ=BDFS_ERR_END_OF_DIR C=active count
    75                          MARVIN_BDFS_FILE_WRITE        EQU 0x00C4  ; in: HL=filename DE=src BC=len  out: Z=ok NZ=BDFS_ERR_*
    76                          MARVIN_BDFS_GET_ERR_MSG       EQU 0x00C7  ; in: A=BDFS_ERR_*  out: HL=message string (0 if unknown)
    77                          MARVIN_BDFS_FILE_READ         EQU 0x00CA  ; in: HL=filename DE=dest  out: Z=ok BC=bytes NZ=BDFS_ERR_*  read file into RAM
    78                          MARVIN_BDFS_FILE_DELETE       EQU 0x00CD  ; in: HL=filename  out: Z=ok NZ=BDFS_ERR_*  soft-delete file
    79                          
    80                          ; String utilities  (all targets)
    81                          MARVIN_PUTCHAR_DEC            EQU 0x00D0  ; in: A=value               print byte as decimal (no leading zeros)
    82                          MARVIN_HEX_BYTE_VAL           EQU 0x00D3  ; in: HL=hex_str  out: A=byte HL=advanced  parse 2 hex chars to byte
    83                          
    84                          ENDIF ; _MARVIN_INC
    85                          
main.asm:
     2                          
     3                              ORG ORGDEF
     4                          
     5                          start:
     6                              ; load the message address into HL
     7  0000  210c00                ld hl,message
     8                          print:
     9                              ; call the monitor puts routine, which will print to the console the message pointed to by HL
    10  0003  cd4900                call MARVIN_PUTS
    11                          wait:
    12                              ; call the monitor getchar to get a character from the console input
    13                              ; this will wait until a character is received
    14  0006  cd4c00                call MARVIN_GETCHAR
    15                          end:
    16                              ; jump back to the monitor
    17  0009  c34000                jp MARVIN_WARMSTART
    18                          
    19                          message:
    20                              ; message to be printed
    21                              ; must be terminated by a 0
    22  000c  48656c6c6f20776f      db "Hello world!\n"
              726c64210a        
    23  0019  2868697420616e79      db "(hit any key)\n",0
              206b6579290a00    
    24                          
